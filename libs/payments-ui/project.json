{
  "name": "payments-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/payments-ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/payments-ui/.storybook",
        "browserTarget": "payments-ui:build-storybook",
        "compodoc": true,
        "styles": ["libs/theme-styles/src/lib/base.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/payments-ui",
        "configDir": "libs/payments-ui/.storybook",
        "browserTarget": "payments-ui:build-storybook",
        "compodoc": true,
        "styles": ["libs/theme-styles/src/lib/base.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "payments-ui:build-storybook",
        "staticFilePath": "dist/storybook/payments-ui",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "payments-ui:build-storybook:ci"
        }
      }
    }
  }
}
