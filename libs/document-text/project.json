{
  "name": "document-text",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/document-text/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/document-text",
        "main": "libs/document-text/src/index.ts",
        "tsConfig": "libs/document-text/tsconfig.lib.json",
        "assets": [
          "libs/document-text/package.json",
          "libs/document-text/README.md"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/document-text/jest.config.ts"
      }
    }
  }
}
