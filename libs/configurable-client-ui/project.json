{
  "name": "configurable-client-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/configurable-client-ui/src",
  "prefix": "otui",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/configurable-client-ui/jest.config.ts",
        "coverageReporters": ["json-summary", "lcov", "text"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/configurable-client-ui/.storybook",
        "browserTarget": "configurable-client-ui:build-storybook",
        "compodoc": true,
        "styles": ["libs/theme-styles/src/lib/base.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/configurable-client-ui",
        "configDir": "libs/configurable-client-ui/.storybook",
        "browserTarget": "configurable-client-ui:build-storybook",
        "compodoc": true,
        "styles": ["libs/theme-styles/src/lib/base.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "configurable-client-ui:build-storybook",
        "staticFilePath": "dist/storybook/configurable-client-ui",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "configurable-client-ui:build-storybook:ci"
        }
      }
    }
  }
}
