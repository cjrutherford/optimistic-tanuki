{
  "name": "business-presence-feature",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/business-presence-feature/src",
  "projectType": "library",
  "tags": ["scope:business", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/business-presence-feature",
        "main": "libs/business-presence-feature/src/index.ts",
        "tsConfig": "libs/business-presence-feature/tsconfig.lib.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/business-presence-feature/jest.config.ts"
      }
    }
  }
}
