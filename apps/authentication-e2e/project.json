{
  "name": "authentication-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "authentication",
    "profile",
    "permissions",
    "social",
    "forum",
    "assets",
    "videos",
    "workspace",
    "app-configurator",
    "chat-collector",
    "classifieds",
    "payments"
  ],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/authentication-e2e/jest.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": [
        "authentication:build",
        "profile:build",
        "permissions:build",
        "social:build",
        "forum:build",
        "assets:build",
        "videos:build",
        "workspace:build",
        "app-configurator:build",
        "chat-collector:build",
        "classifieds:build",
        "payments:build"
      ]
    }
  },
  "tags": ["type:e2e"]
}
