{
  "name": "compliance-audit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/compliance-audit/src",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/compliance-audit"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/compliance-audit/package.json",
        "{workspaceRoot}/dist/apps/compliance-audit/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/compliance-audit/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "compliance-audit:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "compliance-audit:build:development"
        },
        "production": {
          "buildTarget": "compliance-audit:build:production"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "jest --config apps/compliance-audit/jest.config.ts --passWithNoTests",
        "env": {
          "NODE_OPTIONS": "--experimental-vm-modules"
        }
      },
      "configurations": {
        "ci": {
          "command": "jest --config apps/compliance-audit/jest.config.ts --passWithNoTests --ci --coverage --coverageReporters=json-summary --coverageReporters=lcov --coverageReporters=text"
        }
      }
    },
    "typeorm:migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js -d src/app/staticDatabase.ts migration:generate",
        "cwd": "apps/compliance-audit",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json"
        }
      }
    },
    "typeorm:migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js -d src/app/staticDatabase.ts migration:run",
        "cwd": "apps/compliance-audit",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json"
        }
      }
    },
    "typeorm:migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js -d src/app/staticDatabase.ts migration:revert",
        "cwd": "apps/compliance-audit",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json"
        }
      }
    }
  }
}
