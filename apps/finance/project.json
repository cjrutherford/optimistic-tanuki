{
  "name": "finance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/finance/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "options": {
        "webpackConfig": "apps/finance/webpack.config.js",
        "outputPath": "dist/apps/finance"
      },
      "configurations": {
        "development": {},
        "production": {}
      },
      "defaultConfiguration": "production"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/finance/package.json",
        "{workspaceRoot}/dist/apps/finance/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/finance/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "finance:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "finance:build:development"
        },
        "production": {
          "buildTarget": "finance:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/finance/jest.config.ts"
      }
    },
    "typeorm:migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:generate -d src/app/staticDatabase.ts",
        "cwd": "apps/finance",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "typeorm:migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:run -d src/app/staticDatabase.ts",
        "cwd": "apps/finance",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "typeorm:migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:revert -d src/app/staticDatabase.ts",
        "cwd": "apps/finance",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "typeorm:migration:show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:show -d src/app/staticDatabase.ts",
        "cwd": "apps/finance",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    }
  },
  "tags": [
    "type:app",
    "scope:finance",
    "platform:server",
    "visibility:internal"
  ]
}
