{
  "name": "ui-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ui-playground/src",
  "tags": ["type:app", "scope:motion", "platform:web", "visibility:internal"],
  "targets": {
    "docs-content": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/docs-site/build-storybook-docs.mjs"
      }
    },
    "api-docs-content": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/docs-site/build-compodoc-index.mjs"
      }
    },
    "docs-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node tools/docs-site/build-compodoc-index.mjs",
          "node tools/docs-site/build-storybook-docs.mjs"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@storybook/angular:build-storybook",
      "dependsOn": ["docs-build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/tools/docs-site/**/*",
        "{workspaceRoot}/tools/storybook/**/*",
        "{workspaceRoot}/libs/*/src/**/*",
        "{workspaceRoot}/libs/*/.storybook/*"
      ],
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/apps/ui-playground/browser",
        "configDir": "apps/ui-playground/.storybook",
        "browserTarget": "ui-playground:build",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "apps/ui-playground/generated"],
        "styles": ["libs/theme-styles/src/lib/base.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        },
        "development": {},
        "production": {}
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@storybook/angular:start-storybook",
      "dependsOn": ["docs-build"],
      "options": {
        "port": 4310,
        "configDir": "apps/ui-playground/.storybook",
        "browserTarget": "ui-playground:build",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "apps/ui-playground/generated"],
        "styles": ["libs/theme-styles/src/lib/base.scss"]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ui-playground/jest.config.ts",
        "tsConfig": "apps/ui-playground/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "ui-playground:build",
        "port": 4310,
        "staticFilePath": "dist/apps/ui-playground/browser",
        "spa": false
      }
    }
  }
}
