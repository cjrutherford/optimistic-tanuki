{
  "version": 1,
  "scope": "A01 O10 payments safe shared-account source capture. Shared financial receipts and wallet totals are included for the subject account without inferred app scope; attribution is recorded-unverified and consent is not inferred.",
  "selection": {
    "principal": "subject-account-owned-and-shared-financial-records",
    "appScope": "not present on financial rows; no appScope filter is inferred",
    "selectors": [
      "Donation.userId",
      "ClassifiedPayment.buyerId OR sellerId (never interestedBuyerId alone)",
      "SellerWallet.sellerId",
      "Transaction.userId",
      "Offer.buyerId OR sellerId",
      "PayoutRequest.sellerId",
      "BusinessPage.ownerId",
      "BusinessTheme through selected BusinessPage.ownerId",
      "CommunitySponsorship.userId",
      "LemonSqueezyProduct excluded with zero rows"
    ]
  },
  "entities": [
    {
      "name": "Donation",
      "table": "donations",
      "source": "apps/payments/src/entities/donation.entity.ts",
      "columns": [
        {
          "fields": ["id"],
          "classification": "owned",
          "action": "include-owned",
          "handling": "Selected account receipt identifier.",
          "reason": "Opaque identifier for the subject's donation receipt.",
          "evidence": [
            "apps/payments/src/app/loadDatabase.ts",
            "apps/payments/src/entities/donation.entity.ts",
            "apps/payments/src/app/account-export-sources.ts"
          ]
        },
        {
          "fields": [
            "userId",
            "profileId",
            "amount",
            "isRecurring",
            "status",
            "currency",
            "createdAt",
            "cancelledAt"
          ],
          "classification": "owned",
          "action": "typed-projection",
          "handling": "Project only bounded account receipt fields; bind non-null profileId to captured identity snapshot or fail capture.",
          "reason": "Safe donation receipt facts and amounts belong to the subject's shared account history.",
          "evidence": [
            "apps/payments/src/entities/donation.entity.ts",
            "apps/payments/src/app/account-export-sources.ts"
          ]
        },
        {
          "fields": ["lemonSqueezyOrderId", "lemonSqueezySubscriptionId"],
          "classification": "opaque",
          "action": "exclude",
          "handling": "Omit provider identifiers.",
          "reason": "Provider identifiers are unnecessary for the receipt and can expose cross-system linkage.",
          "evidence": ["apps/payments/src/entities/donation.entity.ts"]
        },
        {
          "fields": ["message", "anonymous"],
          "classification": "shared",
          "action": "exclude",
          "handling": "Omit donor freeform text and visibility preference.",
          "reason": "Freeform/private content and audience preference are outside safe-source capture.",
          "evidence": ["apps/payments/src/entities/donation.entity.ts"]
        }
      ],
      "relations": []
    },
    {
      "name": "ClassifiedPayment",
      "table": "classified_payments",
      "source": "apps/payments/src/entities/classified-payment.entity.ts",
      "columns": [
        {
          "fields": ["id", "classifiedId", "offerId"],
          "classification": "opaque",
          "action": "opaque-reference",
          "handling": "Include receipt ID and opaque classified/offer references only.",
          "reason": "A shared-account receipt can identify its associated record without exporting counterpart identity.",
          "evidence": [
            "apps/payments/src/entities/classified-payment.entity.ts",
            "apps/payments/src/app/account-export-sources.ts"
          ]
        },
        {
          "fields": [
            "buyerId",
            "sellerId",
            "amount",
            "status",
            "createdAt",
            "confirmedAt",
            "releasedAt"
          ],
          "classification": "owned",
          "action": "typed-projection",
          "handling": "Select by buyer or seller account; project the subject's role and receipt values only.",
          "reason": "The account may participate as buyer or seller; both are shared financial history.",
          "evidence": [
            "apps/payments/src/entities/classified-payment.entity.ts",
            "apps/payments/src/app/account-export-sources.ts"
          ]
        },
        {
          "fields": ["interestedBuyerId"],
          "classification": "shared",
          "action": "exclude",
          "handling": "Do not use as a selector or emit.",
          "reason": "Interest alone is not participation in the payment receipt.",
