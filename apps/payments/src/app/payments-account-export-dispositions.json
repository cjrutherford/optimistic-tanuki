            "apps/payments/src/entities/classified-payment.entity.ts"
          ]
        },
        {
          "fields": [
            "platformFeeAmount",
            "sellerReceivesAmount",
            "LemonSqueezyOrderId"
          ],
          "classification": "opaque",
          "action": "exclude",
          "handling": "Omit internal fee split and provider order identifier.",
          "reason": "Avoid provider linkage and details not needed for a safe receipt.",
          "evidence": [
            "apps/payments/src/entities/classified-payment.entity.ts"
          ]
        },
        {
          "fields": ["paymentIntentId"],
          "classification": "opaque",
          "action": "exclude",
          "handling": "Omit provider payment-intent identifiers.",
          "reason": "Provider handles are excluded from the approved portable receipt.",
          "evidence": [
            "apps/payments/src/entities/classified-payment.entity.ts",
            "apps/payments/src/app/account-export-sources.ts"
          ]
        },
        {
          "fields": ["paymentMethod"],
          "classification": "nonpersonal",
          "action": "exclude",
          "handling": "Omit payment method.",
          "reason": "Payment credential context is excluded.",
          "evidence": [
            "apps/payments/src/entities/classified-payment.entity.ts"
          ]
        },
        {
          "fields": ["proofImageUrl", "disputeReason"],
          "classification": "shared",
          "action": "exclude",
          "handling": "Omit proof and dispute content.",
          "reason": "Private dispute/proof content is explicitly excluded.",
          "evidence": [
            "apps/payments/src/entities/classified-payment.entity.ts"
          ]
        }
      ],
      "relations": []
    },
