      "action": "exclude",
      "handling": "Never exported.",
      "reason": "Inputs can contain credentials.",
      "evidence": [
        "apps/app-configurator/src/configurations/entities/app-configuration.entity.ts"
      ],
      "kind": "operational-input"
    }
  ]
}
