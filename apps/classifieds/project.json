{
  "name": "classifieds",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/classifieds/src",
  "tags": [
    "type:app",
    "scope:classifieds",
    "platform:server",
    "visibility:internal"
  ],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "options": {
        "webpackConfig": "apps/classifieds/webpack.config.js",
        "outputPath": "dist/apps/classifieds"
      },
      "configurations": {
        "development": {},
        "production": {}
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "classifieds:build",
        "main": "apps/classifieds/src/main.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/classifieds/jest.config.ts"
      }
    },
    "typeorm:migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:generate -d src/app/staticDatabase.ts",
        "cwd": "apps/classifieds",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "typeorm:migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:run -d src/app/staticDatabase.ts",
        "cwd": "apps/classifieds",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "typeorm:migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:revert -d src/app/staticDatabase.ts",
        "cwd": "apps/classifieds",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "typeorm:migration:show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:show -d src/app/staticDatabase.ts",
        "cwd": "apps/classifieds",
        "env": {
          "TS_NODE_PROJECT": "tsconfig.app.json",
          "POSTGRES_HOST": "127.0.0.1"
        }
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t classifieds:latest -f apps/classifieds/Dockerfile ."
      }
    }
  }
}
